# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# Then replace the values below with settings for your host/network.

# ROS 2 domain shared by Isaac Sim, PCD converter, and the ROS 2 ros_bridge side.
ROS_DOMAIN_ID=0


PICKIT_ROS2_IP=192.168.1.100

# Absolute host paths for Isaac Sim persistent data and cache.
# Create the directories if necessary, and replace both placeholders.
ISAAC_DATA_DIR=/absolute/path/to/isaac-sim-data
ISAAC_CACHE_DIR=/absolute/path/to/isaac-sim-cache

